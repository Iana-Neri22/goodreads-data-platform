# Copie este arquivo para .env e ajuste os valores conforme necessário.
# Todas as variáveis são opcionais — os valores abaixo são os padrões.

# Caminho para o banco DuckDB
# GOODREADS_DB_PATH=warehouse.duckdb

# Caminho para o CSV de entrada
# GOODREADS_CSV_PATH=data/books.csv

# Pasta de destino dos CSVs exportados
# GOODREADS_EXPORTS_PATH=data/exports

# Caminho para o arquivo de log
# GOODREADS_LOG_PATH=logs/pipeline.log

# Tamanho máximo do arquivo de log antes da rotação (em bytes)
# GOODREADS_LOG_MAX_BYTES=1000000

# Número de arquivos de log rotacionados mantidos
# GOODREADS_LOG_BACKUP_COUNT=5

# Mínimo de avaliações para um livro entrar em gold.top_books
# GOODREADS_MIN_RATINGS_FOR_TOP_BOOKS=1000

# Fração mínima de linhas da bronze que deve sobreviver para a silver (0.0–1.0)
# GOODREADS_MIN_SILVER_RETENTION_PCT=0.80
